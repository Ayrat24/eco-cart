  m_TableData:
  - m_Id: 7291793408
    m_Localized: "\u041A\u043B\u0438\u043A\u0430\u0439\u0442\u0435 \u041F\u041A\u041C
      \u043F\u043E \u0437\u0435\u043C\u043B\u0435, \u0447\u0442\u043E \u0431\u044B
      \u0434\u0432\u0438\u0433\u0430\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 97389637632
    m_Localized: "\u0417\u0430\u0436\u043C\u0438\u0442\u0435 \u041B\u041A\u041C \u0447\u0442\u043E
      \u0431\u044B \u043F\u0435\u0440\u0435\u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C
      \u043E\u0442\u0445\u043E\u0434\u044B \u0432 \u0442\u0435\u043B\u0435\u0436\u043A\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 22894799277256704
    m_Localized: "\u0426\u0435\u043B\u044C \u0438\u0433\u0440\u044B - \u043E\u0447\u0438\u0449\u0435\u043D\u0438\u044F
      \u043C\u0438\u0440\u0430, \u043F\u043E\u0441\u0430\u0434\u043A\u0430 \u0434\u0435\u0440\u0435\u0432\u044C\u0435\u0432
      \u0438 \u0437\u0430\u0440\u0430\u0431\u043E\u0442\u043E\u043A \u0434\u0435\u043D\u0435\u0433!"
    m_Metadata:
      m_Items: []
  - m_Id: 22895318750195712
    m_Localized: "\u0423\u043B\u0443\u0447\u0448\u0435\u043D\u0438\u044F \u0442\u0443\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 22896025087766528
    m_Localized: "\u041C\u0435\u043D\u044F\u0439 \u0441\u043D\u0430\u0440\u044F\u0436\u0435\u043D\u0438\u0435
      \u0442\u0443\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 22896155421569024
    m_Localized: "\u0421\u043B\u0435\u0434\u0438 \u0437\u0430 \u043F\u0440\u043E\u0433\u0440\u0435\u0441\u0441\u043E\u043C
      \u0442\u0443\u0442. \u0412\u0441\u0435\u0433\u0434\u0430 \u043C\u043E\u0436\u043D\u043E
      \u0441\u043C\u0435\u043D\u0438\u0442\u044C \u043C\u0438\u0440, \u043A\u043B\u0438\u043A\u043D\u0443\u0432
      \u043D\u0430 \u043A\u043D\u043E\u043F\u043A\u0443 \u0441 \u043F\u043B\u0430\u043D\u0435\u0442\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 22898894016868352
    m_Localized: "\u042D\u0442\u0430 \u0448\u043A\u0430\u043B\u0430 \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442
      \u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0432\u0435\u0441\u0430 \u043C\u043E\u0436\u0435\u0442
      \u0432\u044B\u0434\u0435\u0440\u0436\u0430\u0442\u044C \u0442\u0432\u043E\u044F
      \u0442\u0435\u043B\u0435\u0436\u043A\u0430"
    m_Metadata:
      m_Items: []
