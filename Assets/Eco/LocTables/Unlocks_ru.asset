  m_TableData:
  - m_Id: 7769944064
    m_Localized: "\u041A\u0430\u0440\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 208576442368
    m_Localized: "\u0420\u0430\u0437\u0431\u043B\u043E\u043A\u0438\u0440\u0443\u0439\u0442\u0435
      \u043A\u0430\u0440\u0442\u0443, \u043A\u043E\u0442\u043E\u0440\u0430\u044F
      \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442 \u0432\u0430\u0448\u0438
      \u043A\u043E\u043E\u0440\u0434\u0438\u043D\u0430\u0442\u044B, \u043D\u0435\u043F\u0435\u0440\u0435\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u043D\u044B\u0439
      \u043C\u0443\u0441\u043E\u0440, \u043F\u043E\u0441\u0430\u0436\u0435\u043D\u043D\u044B\u0435
      \u0434\u0435\u0440\u0435\u0432\u044C\u044F \u0438 \u0434\u0440\u0443\u0433\u043E\u0435!"
    m_Metadata:
      m_Items: []
  - m_Id: 796181655552
    m_Localized: "\u041A\u0443\u043F\u043B\u0435\u043D\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 13530671607808
    m_Localized: "\u041D\u043E\u0432\u043E\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 2228294378319872
    m_Localized: "\u041B\u043E\u043F\u0430\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2228378205679616
    m_Localized: "\u041F\u043E\u0437\u0432\u043E\u043B\u044F\u0435\u0442 \u0440\u0430\u0441\u0447\u0438\u0449\u0430\u0442\u044C
      \u043A\u0443\u0447\u0438 \u043C\u0443\u0441\u043E\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 10946175085572096
    m_Localized: "\u041E\u0447\u043A\u0438 \u0437\u0430 \u043A\u0443\u0447\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 10946236213358592
    m_Localized: "\u0423\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0435\u0442
      \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E \u043E\u0447\u043A\u043E\u0432,
      \u043A\u043E\u0442\u043E\u0440\u043E\u0435 \u0434\u0430\u0435\u0442\u0441\u044F
      \u0437\u0430 \u043E\u0447\u0438\u0449\u0435\u043D\u0438\u0435 \u043A\u0443\u0447\u0438.
      \u0422\u0435\u043A\u0443\u0449\u0438\u0435 \u043E\u0447\u043A\u0438: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 10946272200486912
    m_Localized: "\u041C\u043E\u0449\u044C \u043B\u043E\u043F\u0430\u0442\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 10946326416060416
    m_Localized: "\u0423\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0435\u0442
      \u044D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u043E\u0441\u0442\u044C
      \u043B\u043E\u043F\u0430\u0442\u044B - \u043D\u0443\u0436\u043D\u043E \u043A\u043E\u043F\u0430\u0442\u044C
      \u043C\u0435\u043D\u044C\u0448\u0435! \u0422\u0435\u043A\u0443\u0449\u0430\u044F
      \u043C\u043E\u0449\u044C: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 10946356652797952
    m_Localized: "\u0426\u0432\u0435\u0442\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 10946392983859200
    m_Localized: "\u041D\u0430 \u043C\u0435\u0441\u0442\u0435 \u043E\u0447\u0438\u0449\u0435\u043D\u043D\u044B\u0445
      \u043A\u0443\u0447 \u043F\u043E\u044F\u0432\u043B\u044F\u044E\u0442\u0441\u044F
      \u0446\u0432\u0435\u0442\u044B. \u0423\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0435\u0442
      \u043E\u0447\u043A\u0438 \u0437\u0430 \u043E\u0447\u0438\u0449\u0435\u043D\u0438\u0435
      \u043A\u0443\u0447\u0438 \u043D\u0430 50%"
    m_Metadata:
      m_Items: []
  - m_Id: 10946427381346304
    m_Localized: "\u0411\u0430\u0431\u043E\u0447\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 10946471983575040
    m_Localized: "\u0411\u0430\u0431\u043E\u0447\u043A\u0438 \u043B\u0435\u0442\u0430\u044E\u0442
      \u0432\u043E\u043A\u0440\u0443\u0433 \u0446\u0432\u0435\u0442\u043E\u0432.
      \u0423\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0435\u0442 \u043E\u0447\u043A\u0438
      \u0437\u0430 \u043E\u0447\u0438\u0449\u0435\u043D\u0438\u0435 \u043A\u0443\u0447\u0438
      \u043D\u0430 100%"
    m_Metadata:
      m_Items: []
  - m_Id: 11337783488540672
    m_Localized: "\u0421\u0430\u0436\u0435\u043D\u0446\u044B \u0434\u0435\u0440\u0435\u0432\u044C\u0435\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 11337832914219008
    m_Localized: "\u041E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442 \u0432\u043A\u043B\u0430\u0434\u043A\u0443
      \"\u0414\u0435\u0440\u0435\u0432\u044C\u044F\", \u0432 \u043A\u043E\u0442\u043E\u0440\u043E\u0439
      \u043C\u043E\u0436\u043D\u043E \u0441\u0430\u0436\u0430\u0442\u044C \u0434\u0435\u0440\u0435\u0432\u044C\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 11338591995162624
    m_Localized: "\u041F\u043E\u043C\u043E\u0449\u043D\u0438\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 11338689202352128
    m_Localized: "\u041E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442 \u0432\u043A\u043B\u0430\u0434\u043A\u0443
      \"\u041F\u043E\u043C\u043E\u0449\u043D\u0438\u043A\u0438\", \u0433\u0434\u0435
      \u043C\u043E\u0436\u043D\u043E \u043D\u0430\u043D\u0438\u043C\u0430\u0442\u044C
      \u043F\u043E\u043C\u043E\u0449\u043D\u0438\u043A\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 11339528558080000
    m_Localized: "\u0413\u0430\u0440\u0434\u0435\u0440\u043E\u0431"
    m_Metadata:
      m_Items: []
  - m_Id: 11339602365247488
    m_Localized: "\u041E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442 \u0432\u043A\u043B\u0430\u0434\u043A\u0443
      \"\u0428\u0430\u043F\u043A\u0438\", \u0433\u0434\u0435 \u043C\u043E\u0436\u043D\u043E
      \u043D\u0430\u0434\u0435\u0442\u044C \u043D\u0430 \u0441\u0435\u0431\u044F
      \u0440\u0430\u0437\u043D\u044B\u0435 \u0433\u043E\u043B\u043E\u0432\u043D\u044B\u0435
      \u0443\u0431\u043E\u0440\u044B"
    m_Metadata:
      m_Items: []
