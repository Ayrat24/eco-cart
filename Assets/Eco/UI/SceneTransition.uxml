<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Eco/UI/SceneTransition.uss?fileID=7433441132597879392&amp;guid=09e1478ab21d4efd93d83678621b5c69&amp;type=3#SceneTransition" />
    <Style src="project://database/Assets/Eco/UI/BackgroundColors.uss?fileID=7433441132597879392&amp;guid=404a0c799aeb1484f94faf474cec9a85&amp;type=3#BackgroundColors" />
    <Style src="project://database/Assets/Eco/UI/GameStyle.uss?fileID=7433441132597879392&amp;guid=a847fe3b45fb5dd46b299e93398b68bf&amp;type=3#GameStyle" />
    <ui:VisualElement name="TransitionOverlay" class="hiddenScreen background hide" style="flex-grow: 1; position: absolute; width: 100%; height: 100%; justify-content: center; align-items: center; display: flex; opacity: 1; transition-duration: 0.2s;">
        <ui:VisualElement name="LoadingContainer" class="small" style="flex-grow: 0; align-items: center; justify-content: center; display: flex; transition-duration: 0.2s;">
            <ui:VisualElement name="LoadingSpinner" style="width: 80px; height: 80px; border-left-color: rgb(242, 232, 207); border-right-color: rgb(242, 232, 207); border-top-color: rgb(242, 232, 207); border-bottom-color: rgb(242, 232, 207); border-left-width: 8px; border-right-width: 8px; border-top-width: 8px; border-bottom-width: 8px; border-top-left-radius: 50%; border-top-right-radius: 50%; border-bottom-right-radius: 50%; border-bottom-left-radius: 50%; margin-bottom: 20px; border-top-color: rgba(242, 232, 207, 0.3); border-right-color: rgba(242, 232, 207, 0.3); border-bottom-color: rgba(242, 232, 207, 0.3);" />
            <ui:Label text="Loading..." name="LoadingText" style="font-size: 28px; color: rgb(242, 232, 207); -unity-font-definition: url(&quot;project://database/Assets/OmniSARTechnologies/LiteFPSCounter/Fonts/Roboto-Bold.ttf?fileID=12800000&amp;guid=cee59b8ccb26c724398baa8310abdb3f&amp;type=3#Roboto-Bold&quot;); -unity-text-align: middle-center;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
