.score-popup {
    position: absolute;
    opacity: 0;
    transition-property: opacity, translate;
    transition-duration: 0.5s, 2s;
    transition-timing-function: ease-out, ease-out;
}

.hide {
    opacity: 0;
    translate: 0 0;
    visibility: visible;
    background-color: rgba(0, 0, 0, 0);
    scale: 2 2 2;
}

.score-popup-container {
    padding: 8px 16px;
    background-color: rgba(242, 232, 207, 0.8);
    border-radius: 8px;
    border-width: 2px;
    border-color: rgb(255, 215, 0);
    transition-duration: 0.25s;
}

.money-label {
    font-size: 28px;
    color: rgb(56, 102, 65);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0);
    -unity-font-definition: url("project://database/Assets/OmniSARTechnologies/LiteFPSCounter/Fonts/Roboto-Bold.ttf?fileID=12800000&guid=cee59b8ccb26c724398baa8310abdb3f&type=3#Roboto-Bold");
}
